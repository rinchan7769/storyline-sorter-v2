# レシート画像のLLMビジョン抽出(任意)。未設定の場合はモック抽出器が使われます。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# SQLiteファイルの場所(省略時 ./data/budget.db)
DATABASE_PATH=

# --- 外出先から使う場合(必須) ---
# ログイン用パスワード。本番(NODE_ENV=production)では未設定だと全アクセスを拒否します。
APP_PASSWORD=
# Cookie署名用のランダム文字列(例: openssl rand -hex 32)
AUTH_SECRET=
# http(非HTTPS)でアクセスする場合のみ false。既定は本番でtrue
COOKIE_SECURE=
